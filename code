const int piezoPin = A0;
const int ledPin = 13;
int threshold = 40;

void setup() {
  pinMode(piezoPin,INPUT);
  pinMode(ledPin, OUTPUT);
  Serial.begin(9600);
  
  for(int i=0; i<3; i++) {
    digitalWrite(ledPin, HIGH);
    delay(500);
    digitalWrite(ledPin, LOW);
    delay(500);
  }
}

void loop() {
  int energyLevel = analogRead(piezoPin);
  Serial.println(energyLevel);

  if (energyLevel >= threshold) {
    digitalWrite(ledPin, HIGH);
    delay(200);
  } else {
    digitalWrite(ledPin, LOW);
  }
  delay(1);
}